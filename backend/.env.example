ASTRA_DB_APPLICATION_TOKEN=AstraCS:...
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_KEYSPACE=agrosense
ASTRA_DB_COLLECTION=transactions
ASTRA_DB_FINANCE_COLLECTION=finance_entries

# Langflow URL — pilih salah satu sesuai cara menjalankan Langflow:
#
#   Langflow di host lokal (Docker Desktop — Mac/Windows):
#     LANGFLOW_API_URL=http://host.docker.internal:7860/api/v1/run/<flow-id>
#
#   Langflow di host lokal (Linux, tanpa Docker Desktop):
#     LANGFLOW_API_URL=http://172.17.0.1:7860/api/v1/run/<flow-id>
#
#   Langflow sebagai service di docker-compose.yml (service name "langflow"):
#     LANGFLOW_API_URL=http://langflow:7860/api/v1/run/<flow-id>
#
#   Langflow cloud / remote:
#     LANGFLOW_API_URL=https://your-langflow-instance.example.com/api/v1/run/<flow-id>
#
LANGFLOW_API_URL=http://host.docker.internal:7860/api/v1/run/<flow-id>
LANGFLOW_API_KEY=
