# ── Dev image: lightweight, hot-reload via uvicorn --reload ──────────────────
# Source code is mounted as a volume at runtime (see docker-compose.dev.yml),
# so no COPY of application files is needed here — only dependencies.
FROM python:3.12-slim

WORKDIR /app

# Install dependencies once; they are NOT volume-mounted so this layer is cached
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

EXPOSE 8000

# --reload watches all .py files under /app and restarts on every change.
# The host mounts ./backend → /app, so edits on the host are reflected instantly.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app"]
