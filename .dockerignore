# This file applies only when the repository root is used as Docker build context.
# Compose currently builds from ./backend and ./frontend; keep service-specific
# .dockerignore files in those directories when adding sensitive or large files.
.git
.gitignore

.bob

# Python cache and local environment files must never enter an image.
**/__pycache__
**/*.pyc
**/*.pyo
**/.env
backend/.env

# Frontend dependencies and build output are recreated inside the image.
frontend/node_modules
frontend/.next
frontend/.next/cache

# Development-only Docker definitions are not needed in production context.
**/Dockerfile.dev
docker-compose.dev.yml

**/*.log
*.md
