# frontend/.gitignore
# Root .gitignore already covers: node_modules, .next, .env*, .DS_Store,
# *.pem, *.log, *.tsbuildinfo, next-env.d.ts, .vercel, coverage, .yarn/*
# Entries here are Next.js/frontend-specific additions.

# Yarn PnP (kept here for IDE plug-ins that read from nearest .gitignore)
.pnp
.pnp.*

# Next.js standalone output (generated by output:"standalone")
.next/standalone/

# Storybook
storybook-static/

# Playwright / Cypress test artefacts
/test-results/
/playwright-report/
/playwright/.cache/
/cypress/videos/
/cypress/screenshots/

# Bundle analyser output
.next/analyze/

# Local Vercel project config (can contain project ID)
.vercel

# Agents
AGENTS.md
CLAUDE.md