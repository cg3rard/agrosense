# Development image; docker-compose.dev.yml bind-mounts frontend source at /app.
FROM node:20-alpine

WORKDIR /app

# Dependencies stay in the frontend_nm Docker volume instead of host node_modules.
COPY package.json package-lock.json* ./
RUN npm ci

EXPOSE 3000

# Start the Next.js development server with hot module replacement.
CMD ["npm", "run", "dev"]
